rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function roleDoc() { return /databases/(default)/documents/roles/$(email()); }
    // the same staff who may edit in the app (the yeshiva account, or rosh / menahel / mazkir / dev) – not the accountant
    function editor() {
      return verified() && (email() == 'admin@example.com'
        || (firestore.exists(roleDoc()) && firestore.get(roleDoc()).data.role in ['rosh', 'menahel', 'mazkir', 'dev']));
    }

    // Screenshots and screen recordings attached to a question for the developer (up to 200MB a file).
    // Nobody reads them from the app: the server attaches them to the email.
    match /questions/{qid}/{file} {
      allow create: if verified() && request.resource.size < 200 * 1024 * 1024;
    }
    // The student file: a photo and documents (medical certificates etc.), up to 20MB a file. Staff only.
    match /students/{sid}/{file} {
      allow read, delete: if editor();
      allow create, update: if editor() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
